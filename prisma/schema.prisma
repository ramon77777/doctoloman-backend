generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  PROFESSIONAL
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DECLINED_BY_PROFESSIONAL
  CANCELLED_BY_PATIENT
  CANCELLED_BY_PROFESSIONAL
  COMPLETED
  NO_SHOW
}

enum TeleconsultationStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_RESULT
  IMAGING
  CERTIFICATE
  OTHER
}

enum MedicalAccessAuditAction {
  GRANT_ACCESS
  REVOKE_ACCESS
  OPEN_PATIENT_MEDICAL_RECORDS
  OPEN_MEDICAL_RECORD
  DOWNLOAD_MEDICAL_RECORD
}

enum PushDevicePlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  TELECONSULTATION_REMINDER
  TELECONSULTATION_STARTED
  TELECONSULTATION_PATIENT_WAITING
  MEDICAL_ACCESS_GRANTED
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
  medicalRecords      MedicalRecord[]

  pushDevices   PushDevice[]
  notifications AppNotification[]

  medicalAccessesGranted MedicalAccess[]      @relation("MedicalAccessPatient")
  medicalAccessAudits    MedicalAccessAudit[] @relation("MedicalAccessAuditPatient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([role])
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String

  city      String?
  district  String?
  address   String?

  birthDate DateTime?
  gender    String?

  bloodGroup   String?
  allergies    String?
  medicalNotes String?

  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName          String
  specialty            String
  structureName        String?
  phone                String
  city                 String?
  area                 String?
  address              String?
  bio                  String?
  languages            String[] @default(["Français"])
  consultationFeeLabel String?
  isVerified           Boolean @default(false)

  appointmentDurationMinutes Int @default(30)

  appointmentReasons AppointmentReason[]
  schedules          ProfessionalSchedule[]
  appointments       Appointment[]
  teleconsultations  TeleconsultationSession[]

  medicalAccesses MedicalAccess[]      @relation("MedicalAccessProfessional")
  medicalAudits   MedicalAccessAudit[] @relation("MedicalAccessAuditProfessional")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialty])
  @@index([city])
  @@index([area])
}

model AppointmentReason {
  id             String @id @default(uuid())
  professionalId String

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  label           String
  durationMinutes Int
  position        Int     @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, label])
  @@index([professionalId])
}

model ProfessionalSchedule {
  id             String @id @default(uuid())
  professionalId String

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  weekday Int
  label   String
  isOpen  Boolean @default(false)

  slots ProfessionalScheduleSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, weekday])
  @@index([professionalId])
}

model ProfessionalScheduleSlot {
  id         String @id @default(uuid())
  scheduleId String

  schedule ProfessionalSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  startTime String
  endTime   String
  position  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

model Appointment {
  id String @id @default(uuid())

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  patientName  String
  patientPhone String

  day    DateTime
  slot   String
  reason String

  status AppointmentStatus @default(PENDING)

  consentAccepted   Boolean   @default(false)
  consentVersion    String?
  consentAcceptedAt DateTime?

  teleconsultation TeleconsultationSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([day])
  @@index([status])
}

model TeleconsultationSession {
  id            String @id @default(uuid())
  appointmentId String @unique

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  patientName  String
  patientPhone String

  scheduledAt DateTime
  reason      String

  status TeleconsultationStatus @default(SCHEDULED)

  consentAccepted   Boolean   @default(false)
  consentAcceptedAt DateTime?

  roomUrl   String?
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([scheduledAt])
  @@index([status])
}

model Pharmacy {
  id        String  @id @default(uuid())
  name      String
  phone     String  @unique
  city      String
  area      String?
  address   String?
  latitude  Float?
  longitude Float?
  isOnDuty  Boolean @default(false)
  isActive  Boolean @default(true)

  dutyPeriods PharmacyDutyPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([area])
  @@index([isOnDuty])
  @@index([isActive])
}

model PharmacyDutyPeriod {
  id         String @id @default(uuid())
  pharmacyId String

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pharmacyId])
  @@index([startsAt])
  @@index([endsAt])
}

model PharmacyNearbySearchCache {
  id String @id @default(uuid())

  cacheKey  String @unique
  latitude  Float
  longitude Float
  radiusKm  Float

  source   String @default("OPENSTREETMAP")
  response Json

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([latitude, longitude])
  @@index([radiusKm])
}

model MedicalRecord {
  id        String @id @default(uuid())
  patientId String

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title       String
  type        MedicalRecordType @default(OTHER)
  description String?

  originalFileName String
  storedFileName   String
  mimeType         String
  sizeBytes        Int
  filePath         String

  accessAudits MedicalAccessAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([type])
  @@index([createdAt])
}

model MedicalAccess {
  id             String @id @default(uuid())
  patientId      String
  professionalId String

  patient      User                @relation("MedicalAccessPatient", fields: [patientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("MedicalAccessProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  audits MedicalAccessAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, professionalId])
  @@index([patientId])
  @@index([professionalId])
  @@index([revokedAt])
}

model MedicalAccessAudit {
  id String @id @default(uuid())

  action MedicalAccessAuditAction

  patientId      String
  professionalId String

  patient      User                @relation("MedicalAccessAuditPatient", fields: [patientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("MedicalAccessAuditProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  medicalAccessId String?
  medicalAccess   MedicalAccess? @relation(fields: [medicalAccessId], references: [id], onDelete: SetNull)

  medicalRecordId    String?
  medicalRecord      MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  medicalRecordTitle String?

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([professionalId])
  @@index([medicalAccessId])
  @@index([medicalRecordId])
  @@index([action])
  @@index([createdAt])
}

model PushDevice {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String             @unique
  platform   PushDevicePlatform @default(UNKNOWN)
  deviceName String?
  appVersion String?

  isActive Boolean   @default(true)
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([lastSeenAt])
}

model AppNotification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(PUSH)
  status  NotificationStatus  @default(PENDING)

  title   String
  message String
  data    Json?

  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}